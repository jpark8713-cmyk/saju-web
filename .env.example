LLM_API_KEY=
# 비우면 기본 모델 claude-sonnet-5-5 (Docs/decisions.md D-021). Opus로 바꾸려면 claude-opus-5-5
LLM_MODEL=
# SQLite 파일(D-030). 비우면 메모리 저장소(개발·테스트 전용, 운영에서는 시작하지 않는다)
# 운영 이미지 기본값: file:/data/saju.db (/data는 Docker 볼륨)
DATABASE_URL=
# true면 DB 폴더가 컨테이너 볼륨이 아닐 때 시작하지 않는다(운영 이미지에 고정)
DB_REQUIRE_VOLUME=
# mock은 개발·테스트에서만 동작한다. 운영에서는 mock이어도 결제가 막힌다(D-028)
PAYMENT_PROVIDER=mock
# 켤 결제 수단(쉼표로 구분). 비우면 kakaopay
PAYMENT_METHODS_ENABLED=kakaopay
PAYMENT_CLIENT_KEY=
PAYMENT_SECRET_KEY=
# 운영 필수: 서비스 주소(예: https://example.com). PDF 생성기와 결제창 복귀 주소에 쓴다
APP_ORIGIN=
# 운영 필수: 환불 접수번호 HMAC 키, 32자 이상 임의 문자열
REFUND_ID_SECRET=
# 앞단 nginx가 X-Real-IP를 덮어써 넣을 때만 true (환불 접수 IP별 횟수 제한)
TRUST_PROXY=
# 테스트 검증용(선택): 한국천문연구원 24절기 시각 fixture 생성에만 쓴다
DATAGOKR_API_KEY=
# console은 개발·테스트 전용(메일을 보내지 않고 개발용 보관함에 넣는다). 실제 메일 서비스는 서비스명·도메인 확정 뒤 연동(D-033)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
# PDF는 DB 폴더 아래 pdf/에 저장한다(사업자 결정 D-033). 아래 두 값은 쓰지 않는다
STORAGE_PROVIDER=local
STORAGE_BUCKET=
# 다운로드 링크·보관 기간(30일)은 src/config/delivery.ts 한 곳에서 바꾼다. 이 값은 쓰지 않는다
DOWNLOAD_TOKEN_TTL_DAYS=
