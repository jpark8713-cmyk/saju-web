# 로컬 Docker 리허설용 환경 변수 예시(Docs/REHEARSAL.md). 복사해서 쓴다: cp .env.rehearsal.example .env.rehearsal
# .env.rehearsal은 커밋하지 않는다(.gitignore). 값은 대화창·로그에 붙여 넣지 않는다.

# 운영 필수: 환불 접수번호 HMAC 키(32자 이상 임의 문자열). 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFUND_ID_SECRET=
# 앞단 nginx가 없는 로컬이라도 운영과 같게 둔다
TRUST_PROXY=true
# 실제 Claude API 키. ALLOW_AI_CALL=1로 리포트까지 만들 때만 필요하다(건당 약 $0.25)
LLM_API_KEY=
# 비우면 기본 모델
LLM_MODEL=

# 아래는 스크립트가 경우마다 넣는다. 여기에는 쓰지 않는다:
#   REHEARSAL_MODE, PAYMENT_PROVIDER, APP_ORIGIN, NODE_ENV, ENABLE_FAKE_LLM, PAYMENT_CLIENT_KEY, PAYMENT_SECRET_KEY
